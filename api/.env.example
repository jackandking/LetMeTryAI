# GitHub API Configuration
# Required environment variables for the /github/create-issue endpoint

# GitHub Personal Access Token (PAT)
# Get from: https://github.com/settings/tokens
# Scopes required: public_repo (or repo for private repositories)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub Repository Configuration
# Owner of the repository where issues will be created
GITHUB_OWNER=jackandking

# Repository name where issues will be created
GITHUB_REPO=LetMeTryAI

# Server Configuration (optional)
PORT=3000
NODE_ENV=production
