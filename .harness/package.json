{
  "name": "letmetry-harness",
  "version": "0.1.0",
  "description": "Harness Engineering orchestration for LetMeTryAI daily automation",
  "type": "module",
  "scripts": {
    "start": "tsx src/scheduler.ts",
    "dev": "tsx watch src/scheduler.ts",
    "build": "tsc",
    "test": "tsx test-manual.mjs",
    "test:mvp": "tsx test-mvp-fast.mjs",
    "test:mvp:full": "tsx test-mvp.mjs",
    "test:all": "npm run test && npm run test:mvp && npm run test:ai",
    "test:ai": "tsx test-ai-fallback.mjs",
    "test:e2e": "tsx test-e2e-publish.mjs",
    "test:e2e:publish": "tsx test-e2e-publish.mjs --publish",
    "typecheck": "tsc --noEmit",
    "verify": "node verify.mjs",
    "clean": "rm -rf dist node_modules harness-test-* harness-mvp-*"
  },
  "dependencies": {
    "croner": "^9.0.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "playwright": "^1.59.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
